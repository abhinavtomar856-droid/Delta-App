<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit page</title>
</head>
<body>
    <h1>You are about to edit the data of : <%=userdata.email%></h1>
    <form method="post" action="/user/<%=userdata.id%>?_method=PATCH">
        <textarea name="username"><%=userdata.username%></textarea>
        <input type="password" name="password" placeholder="Enter your password">
        <button>Submit</button>
    </form>
</body>
</html>